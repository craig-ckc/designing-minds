# Required. Browser-safe Supabase project settings for the admin app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Required in deployed environments; defaults to http://localhost:5173 when
# unset. Origin of the storefront — powers the "Preview" link in the top bar and
# the build-stamp fetch that reports whether a record is live on the site.
VITE_WEB_URL=https://www.your-domain.example

# Optional. Leave blank when admin/vercel.json rewrites /api/* to apps/functions.
# Set this only if the admin app should call the deployed functions app directly.
VITE_API_BASE_URL=

# Optional local-dev override for the Vite /api proxy target (default :8787).
# Read by vite.config.ts via process.env, and Vite does NOT load .env files
# before evaluating its own config — so setting it HERE has no effect. Export it
# in the shell instead: VITE_API_PROXY_TARGET=http://localhost:9000 npm run dev
VITE_API_PROXY_TARGET=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=
