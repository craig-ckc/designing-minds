{
  "name": "@designing-minds/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && npm run optimize:images && npm run prerender",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "optimize:images": "node scripts/optimize-images.mjs dist",
    "prerender": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test ../../tests/web/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@designing-minds/cms": "file:../../packages/cms",
    "@designing-minds/utils": "file:../../packages/utils",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
